# Example environment variables for march-batch-backend
# Copy this file to `.env` and fill in real values (do NOT commit secrets).

# MongoDB connection string (use your Atlas connection or self-hosted URI)
# Example (Atlas): mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/myDatabase
MONGO_URI="your-mongodb-connection-string"

# JWT secret used to sign / verify tokens
JWT_SECRET="your_jwt_secret"

# Email account used by nodemailer (Gmail app password recommended)
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-email-app-password"

# Optional TLS settings (only if your MongoDB requires custom TLS/CA)
# MONGO_TLS="true"
# MONGO_TLS_CA_FILE="/absolute/path/to/ca.pem"
# MONGO_TLS_ALLOW_INVALID="true" # for local testing only — insecure

# App port (optional)
# PORT=3000
